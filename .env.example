# MobiOs Spin & Win Backend Configuration Template

PORT=3000
NODE_ENV=development

# Database (MySQL 8+)
DATABASE_URL="mysql://<user>:<password>@localhost:3306/mobios_spin_win"
DATABASE_URL_TEST="mysql://<user>:<password>@localhost:3306/mobios_spin_win_test"

# JWT Authentication
JWT_SECRET="replace-with-a-cryptographically-secure-random-secret"
JWT_EXPIRES_IN="12h"

# Display & Wheel Security Tokens
DISPLAY_SHARED_SECRET="replace-with-a-secure-display-token"

# Pacing & Exhibition Defaults
DEFAULT_TIMEZONE="Asia/Colombo"
DEFAULT_PACING_START_TIME="09:00:00"
DEFAULT_PACING_END_TIME="21:00:00"

# Initial Admin Bootstrap (Used during seeding/first boot)
INITIAL_ADMIN_EMAIL="admin@mobios.lk"
INITIAL_ADMIN_PASSWORD="SecureInitialPassword@123"
INITIAL_ADMIN_NAME="MobiOs Infotel Admin"

# QR Token Lifetime (seconds)
QR_TOKEN_TTL_SECONDS=15
REG_SESSION_TTL_MINUTES=5

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
